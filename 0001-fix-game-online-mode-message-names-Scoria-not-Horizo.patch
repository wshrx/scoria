From 290ae065b74fd62cac758a1df4e3c7241aa80b7d Mon Sep 17 00:00:00 2001
From: 3 ax <3axmail@gmail.com>
Date: Thu, 29 Oct 2026 20:39:39 +0300
Subject: [PATCH] fix(game): online-mode message names Scoria, not Horizon

Scoria has no Microsoft sign-in; the disconnect text now says so and points to
offline-mode or LAN instead of telling the player to sign in.
---
 crates/horizon-client/src/net.rs       | 2 +-
 crates/horizon-client/src/reconnect.rs | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/crates/horizon-client/src/net.rs b/crates/horizon-client/src/net.rs
index 93364ed91..e9dbf9158 100644
--- a/crates/horizon-client/src/net.rs
+++ b/crates/horizon-client/src/net.rs
@@ -344,7 +344,7 @@ fn status(send: &Sender<Event>, text: &str) {
 }
 
 /// Shown when an online-mode server asks a client without an account to authenticate.
-pub const NOT_SIGNED_IN: &str = "This server is in online mode. Sign in with your Microsoft account in the Horizon launcher to join it.";
+pub const NOT_SIGNED_IN: &str = "This server is in online mode. Scoria has no Microsoft sign-in, so it cannot join. Use an offline-mode server or Open to LAN.";
 
 /// A translation, or the key itself (Language.getOrDefault).
 fn tr(lang: &Language, key: &str) -> String {
diff --git a/crates/horizon-client/src/reconnect.rs b/crates/horizon-client/src/reconnect.rs
index c5184d7ad..db59d3ef7 100644
--- a/crates/horizon-client/src/reconnect.rs
+++ b/crates/horizon-client/src/reconnect.rs
@@ -160,7 +160,7 @@ mod tests {
             "unknown server reasons are not retried"
         );
         assert!(!allowed(
-            "This server is in online mode. Horizon only joins offline-mode servers.",
+            "This server is in online mode. Scoria only joins offline-mode servers.",
             true
         ));
         assert!(!allowed("Kicked for spamming", false));
-- 
