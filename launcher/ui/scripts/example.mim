// Copy this file to the launcher's data folder: <data>/scripts/example.mim
// Build the window with scripts: cargo build -p scoria-ui --features scripts

fn on_start() {
    toast("Scoria scripts are enabled");
}

fn on_game_start() {
    log("Game started");
}

fn on_game_exit() {
    toast("Game closed");
}

fn on_download_done() {
    toast("Minecraft 26.3 is ready");
}
