// Mimas flex tree: rows, columns, padding, gaps and text. Edit and save; the window reloads.
fn draw() {
    clear();
    column(0.0, 0.0, 1280.0, 720.0, "#0B0B0D", 0.0);
        row(40.0, 64.0, 1152.0, 0.0, "#00000000", 0.0);
            align("stretch");
            justify("between");
            column(24.0, 0.0, 640.0, 0.0, "#00000000", 0.0);
                grow(1.0);
                text("MIMAS · FLEX LAYOUT", 10.0, "#9C948C");
                text("Scoria", 56.0, "#F4F0EA");
                text("Rows, columns and spacing come from a script.", 15.0, "#9C948C");
                row(12.0, 0.0, 0.0, 0.0, "#00000000", 0.0);
                    column(10.0, 20.0, 192.0, 52.0, "#FF6A3D", 12.0);
                        text("Draw with Mimas", 16.0, "#1A0A04");
                    end_box();
                    column(10.0, 20.0, 192.0, 52.0, "#1A1A1D", 12.0);
                        text("End_box() closes a node", 12.0, "#F4F0EA");
                    end_box();
                end_box();
                column(16.0, 20.0, 640.0, 120.0, "#141416", 16.0);
                    text("A layout tree, not absolute rectangles.", 20.0, "#F4F0EA");
                    text("The Rust side maps every node to a GPUI flex element.", 13.0, "#9C948C");
                end_box();
            end_box();
            column(20.0, 24.0, 472.0, 560.0, "#1A1A1D", 20.0);
                column(10.0, 20.0, 424.0, 200.0, "#2A1710", 14.0);
                    justify("center");
                    text("POSITIONING", 10.0, "#FF6A3D");
                    text("The script places the panel;", 28.0, "#F4F0EA");
                    text("Rust paints it.", 28.0, "#F4F0EA");
                end_box();
                row(16.0, 0.0, 424.0, 0.0, "#00000000", 0.0);
                    column(10.0, 16.0, 204.0, 120.0, "#202024", 14.0);
                        text("X = 0", 12.0, "#9C948C");
                        text("column", 18.0, "#F4F0EA");
                    end_box();
                    column(10.0, 16.0, 204.0, 120.0, "#202024", 14.0);
                        text("X = 220", 12.0, "#9C948C");
                        text("row", 18.0, "#F4F0EA");
                    end_box();
                end_box();
            end_box();
        end_box();
    end_box();
}
