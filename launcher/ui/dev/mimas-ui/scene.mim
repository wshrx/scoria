// A Mimas preview of the launcher's D · Signal Home. Buttons change the preview mode;
// `preparing()` and `playing()` are host state, and the whole tree is redrawn.
fn draw() {
    clear();
    column(0.0, 0.0, 1280.0, 720.0, "#0B0B0D", 0.0);
        row(24.0, 32.0, 1216.0, 56.0, "#0B0B0D", 0.0);
            align("center");
            text("Scoria", 14.0, "#F4F0EA");
            text("0.1.3", 10.0, "#9C948C");
            row(20.0, 0.0, 0.0, 0.0, "#00000000", 0.0);
                align("center");
                text("Играть", 15.0, "#FF6A3D");
                text("Моды", 15.0, "#9C948C");
                text("Серверы", 15.0, "#9C948C");
            end_box();
            grow(1.0);
            text("Офлайн", 12.0, "#6FBF8B");
        end_box();

        row(40.0, 64.0, 1152.0, 0.0, "#00000000", 0.0);
            align("stretch");
            justify("between");
            column(24.0, 0.0, 640.0, 0.0, "#00000000", 0.0);
                grow(1.0);
                text("ПОСЛЕДНИЙ ЗАПУСК · 2 Ч НАЗАД", 10.0, "#9C948C");
                text("Minecraft 26.3", 72.0, "#F4F0EA");
                text("Ваши миры, моды и серверы.", 15.0, "#9C948C");
                text("Без аккаунта Microsoft и телеметрии.", 15.0, "#9C948C");
                if preparing() {
                    button("Подготовка 42%", "ready", "#2A1710");
                } else if playing() {
                    button("Остановить", "ready", "#1A1A1D");
                } else {
                    button("Играть", "play", "#FF6A3D");
                }
                text("Готово к запуску · 26.3", 13.0, "#6FBF8B");
                column(8.0, 0.0, 0.0, 0.0, "#00000000", 0.0);
                    text("Ваши миры", 20.0, "#F4F0EA");
                    row(16.0, 12.0, 640.0, 64.0, "#1A1A1D", 8.0);
                        text("New World", 16.0, "#F4F0EA");
                        grow(1.0);
                        text("Выживание · 2 ч назад", 12.0, "#9C948C");
                    end_box();
                    row(16.0, 12.0, 640.0, 64.0, "#00000000", 8.0);
                        text("Build", 16.0, "#F4F0EA");
                        grow(1.0);
                        text("Творческий · 3 дня назад", 12.0, "#9C948C");
                    end_box();
                end_box();
            end_box();

            column(20.0, 24.0, 472.0, 560.0, "#1A1A1D", 20.0);
                text("ВЫБРАННЫЙ МИР", 10.0, "#9C948C");
                column(10.0, 20.0, 424.0, 200.0, "#2A1710", 14.0);
                    justify("center");
                    text("New World", 28.0, "#F4F0EA");
                    text("Выживание · 2 ч назад", 12.0, "#9C948C");
                end_box();
                text("Открыть мир", 14.0, "#FF6A3D");
            end_box();
        end_box();
    end_box();
}
