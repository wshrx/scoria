From 3664379f51ff0ae1d0511146dc753406819abb28 Mon Sep 17 00:00:00 2001
From: 3 ax <3axmail@gmail.com>
Date: Thu, 29 Oct 2026 21:02:44 +0300
Subject: [PATCH 6/7] refactor: remove the last Microsoft account surface

- Drop the server create --check-accounts flag: every Scoria server is
  offline-mode, and the CLI no longer exposes an online-mode switch.
- Delete the stale Microsoft-account document; hosting and fork docs say
  offline-only.
- Reword the keychain comments (it stores the friends token) and the launcher
  README account section.
- The client text already says Scoria has no Microsoft sign-in.
---
 crates/horizon-client/src/game/extras.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/horizon-client/src/game/extras.rs b/crates/horizon-client/src/game/extras.rs
index 4d21f5288..d75c4fe6b 100644
--- a/crates/horizon-client/src/game/extras.rs
+++ b/crates/horizon-client/src/game/extras.rs
@@ -119,7 +119,7 @@ impl Game<'_> {
         }
     }
     /// Auto-reconnect: connect again once the countdown is over. An
-    /// online-mode server gets the signed-in account again: `connect_server`
+    /// online-mode server is refused (Scoria has no account): `connect_server`
     /// takes it from `auth::current()`, held in memory for the whole run
     /// (the launcher's session file is gone after the first read).
     pub(super) fn extras_retry(&mut self) -> horizon_client::Result<()> {
